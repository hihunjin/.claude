# Copy to ~/.claude/.env.local and fill in. Never commit the filled-in copy.
# Used by scripts/use_custom_api.sh and scripts/fallback_proxy.py.

# Base URL of the custom Anthropic-compatible gateway.
CUSTOM_API_BASE_URL=""

# Bearer token / API key for that gateway.
CUSTOM_API_KEY=""

# Set to 1 only if the gateway uses a self-signed certificate.
CUSTOM_API_INSECURE_TLS="0"

# Optional: real Anthropic key used as the proxy's fallback backend.
ANTHROPIC_API_KEY_FALLBACK=""
