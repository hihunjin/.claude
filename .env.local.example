# Copy to ~/.claude/.env.local and fill in. Never commit the filled-in copy.
# Used by scripts/use_custom_api.sh and scripts/fallback_proxy.py.

# Base URL of the custom Anthropic-compatible gateway.
CUSTOM_API_BASE_URL=""

# Bearer token / API key for that gateway.
CUSTOM_API_KEY=""

# Set to 1 only if the gateway uses a self-signed certificate.
CUSTOM_API_INSECURE_TLS="0"

# Optional: real Anthropic key used as the proxy's fallback backend.
ANTHROPIC_API_KEY_FALLBACK=""

# --- Self-hosted vLLM (scripts/claude-vllm.sh) ---------------------------------
# Address of the vLLM server: "10.0.0.5:8000" or a full URL, with or without a
# path prefix. Set it here to run claude-vllm.sh with no arguments at all.
VLLM_URL=""

# API key the server expects. Leave empty if it was started without --api-key.
VLLM_API_KEY=""

# Optional: pin a model id instead of being asked when several are served.
VLLM_MODEL=""

# Set to 1 only if the server uses a self-signed certificate.
VLLM_INSECURE_TLS="0"
