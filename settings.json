{
  "model": "opus[1m]",
  "alwaysThinkingEnabled": false,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/scripts/notify.sh 'Claude Code has finished responding.'"
          }
        ]
      }
    ]
  }
}
